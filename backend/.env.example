# ==============================================================================
# EventHub Backend Environment Variables Template
# Copy this file to .env or export these variables in your deployment system.
# ==============================================================================

# Database Connection
DB_URL=jdbc:mysql://localhost:3306/eventhub?sslMode=PREFERRED&autoReconnect=true
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# Server Port
SERVER_PORT=8081

# JWT Configuration (Base64-encoded HMAC-SHA256 key, minimum 256 bits)
JWT_SECRET=your_base64_encoded_jwt_secret_key_minimum_256_bits
JWT_EXPIRATION_MS=86400000
